# Floating-point variables and functions.

void main() {
    float f = 2.34;
    float ff = 0.0;
    ff = 3.0;
    float fff = mult(f,5,ff);
    println(fff);  # 7.02

    fff  = max(f,ff);
    println(fff);  # 3.0

}

float mult(float a, int n, float b) {
   return a * b;
}

float max(float a, float b) {
   if (a>b) return a;
   else return b;
}
